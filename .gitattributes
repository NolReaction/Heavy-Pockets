* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.asset text eol=lf
# Unity native mesh subassets use binary serialization, even with a .asset extension.
Assets/HeavyPockets/Resources/PortCells/*.asset binary !eol
Assets/HeavyPockets/Resources/PortHorizon.asset binary !eol
Assets/HeavyPockets/Resources/MapKits/*.asset binary !eol
*.exr binary
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.fbx binary
*.blend filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
Releases/*.zip filter=lfs diff=lfs merge=lfs -text
